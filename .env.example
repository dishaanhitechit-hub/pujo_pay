# ─── Flask ───────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=

# ─── Database ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://pujo_user:password@localhost:5432/pujo_pay

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET_KEY=
# Token validity in hours (default 8 = one working session)
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# ─── First Admin (seeded on first run) ────────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@pujopay.local
ADMIN_PASSWORD=

# ─── WhatsApp (leave blank — wired in a later step) ───────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
